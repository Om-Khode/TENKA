#!/bin/sh
# commit-msg — enforces the .gitmessage template.
#
# Required shape:
#   <type>: <imperative summary, <= 72 chars>
#
#   <optional body>
#
#   TENKA ~ "<single-line tsundere one-liner about THIS change>"
#
# Enabled by `git config core.hooksPath hooks` (see SETUP.md).

. "$(dirname "$0")/_common.sh"

MSG_FILE=$1
# Drop comment lines and the diff `git commit -v` appends.
BODY=$(sed -e '/^#/d' -e '/^diff --git /,$d' "$MSG_FILE")

# Empty message: git aborts on its own, nothing to say.
printf '%s' "$BODY" | grep -q '[^[:space:]]' || exit 0

SUBJECT=$(printf '%s\n' "$BODY" | grep -v '^[[:space:]]*$' | head -1)

# ─── Exemptions ──────────────────────────────────────────────────────────────
# Merge/revert subjects are generated by git; fixup!/squash! are consumed by an
# interactive rebase and never reach main.
case "$SUBJECT" in
    "Merge "*|"Revert "*|"fixup!"*|"squash!"*) exit 0 ;;
esac

TYPES='feat|fix|refactor|chore|docs|test|perf'

# ─── 1. Subject line ─────────────────────────────────────────────────────────

if ! printf '%s' "$SUBJECT" | grep -Eq "^($TYPES): .+"; then
    die "commit subject does not match the template." \
        "Got:      $SUBJECT" \
        "Expected: <type>: <imperative summary>" \
        "Types:    feat | fix | refactor | chore | docs | test | perf"
fi

SUBJECT_LEN=$(printf '%s' "$SUBJECT" | wc -c | tr -d ' ')
if [ "$SUBJECT_LEN" -gt 72 ]; then
    die "commit subject is ${SUBJECT_LEN} chars (max 72)." \
        "$SUBJECT"
fi

# ─── 2. Mandatory TENKA trailer ──────────────────────────────────────────────

TENKA_LINE=$(printf '%s\n' "$BODY" | grep -E '^[[:space:]]*TENKA ~' | head -1)

if [ -z "$TENKA_LINE" ]; then
    die "missing the mandatory TENKA line." \
        'Every commit ends with:  TENKA ~ "<one-liner>"' \
        "" \
        "In character (tsundere - reluctant, prickly, secretly pleased)," \
        "reacting to what THIS commit actually changes."
fi

if ! printf '%s' "$TENKA_LINE" | grep -Eq '^[[:space:]]*TENKA ~ ".+"[[:space:]]*$'; then
    die "malformed TENKA line." \
        "Got:      $TENKA_LINE" \
        'Expected: TENKA ~ "<text>"   (one line, wrapped in double quotes)'
fi

if [ "$(printf '%s\n' "$BODY" | grep -Ec '^[[:space:]]*TENKA ~')" -gt 1 ]; then
    die "more than one TENKA line." "Exactly one is required."
fi

# ─── 3. Reject the template's own examples ───────────────────────────────────
# .gitmessage says: do NOT reuse verbatim. Write a fresh one per commit.

for sample in \
    'shut up the noisy windows' \
    "remember which tab I was on" \
    'Not because you asked'
do
    if printf '%s' "$TENKA_LINE" | grep -qF "$sample"; then
        die "the TENKA line is copied from the .gitmessage examples." \
            "Write a fresh one that reacts to this specific change."
    fi
done

exit 0
