# ─── Python ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
build/
dist/
.eggs/
.pytest_cache/
.import_linter_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ─── Virtual environments ────────────────────────────────
venv/
.venv/
env/
ENV/

# ─── Secrets / local config ──────────────────────────────
.env
.env.local
*.pem
*.key
credentials/

# ─── User data (defense-in-depth; SANDBOX_DIR lives outside repo) ──
# These should never end up in the repo, but ignore anyway in case
# someone runs TENKA from inside the working tree during development.
*.db
*.db-journal
*.npz
*.npy
*.faiss

# ─── Setup wizard runtime marker (per-machine, schema v1) ─
.tenka_setup.json

# ─── Runtime artifacts ───────────────────────────────────
debug.log
*.log
assistant/debug.log

# ─── Studio daemon (generated / per-run) ─────────────────
# tools/export_openapi.py's throwaway vault root, and the schema it writes
# at repo root when run without a target path -- both regenerated on demand,
# neither meant to be tracked.
.openapi-tmp/
/openapi.json

# ─── Downloaded / cached models ──────────────────────────
# Root-level models/ holds downloaded SpeechBrain / etc. weights.
# Wake-word models in assistant/models/ are ignored by default — only the
# bundled tenka.onnx/tenka.tflite are tracked (negation rules below).
# Custom-trained models you drop in there stay local.
/models/
*.ckpt
*.gguf
*.onnx
*.tflite
!assistant/models/tenka.onnx
!assistant/models/tenka.tflite

# ─── IDE / OS ────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ─── Claude Code session state ───────────────────────────
.superpowers/

# ─── Private / internal docs (not for public repo) ───────
CLAUDE.md
ARCHITECTURE.md
docs/

# ─── Claude Code project-local config ────────────────────
# Ignore everything under .claude/ EXCEPT shared project tooling:
#   settings.json — .env-protection hook; benefits every contributor
#   skills/       — project smoke-test skill
#   rules/        — path-scoped instructions, split out of the gitignored
#                   CLAUDE.md on 2026-08-22 so the rules survive a disk failure
# Uses .claude/* (not .claude/) so the negations below can take effect —
# git cannot re-include a file whose parent directory is excluded.
# settings.local.json stays ignored: personal per-machine overrides.
.claude/*
!.claude/settings.json
!.claude/skills/
!.claude/rules/
